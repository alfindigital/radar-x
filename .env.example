# Sectors Financial API key — https://sectors.app/api (Insider)
SECTORS_API_KEY=
# Optional extra keys, comma-separated — merged with SECTORS_API_KEY into a
# rotating pool (rotates on 401/403 dead keys and 429 quota exhaustion).
SECTORS_API_KEYS=
# Data backend: "json" (local files in ./data) or "supabase"
DATA_SOURCE=json
# Supabase (only when DATA_SOURCE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
