# Reverse allowlist: everything ignored unless explicitly unignored.
# Protects secrets and machine files from ever entering the public repo.
*
!.gitignore
!.gitattributes
!.env.example
!package.json
!package-lock.json
!tsconfig.json
!next-env.d.ts
!next.config.ts
!postcss.config.mjs
!eslint.config.mjs
!README.md
!AGENTS.md
!CLAUDE.md
!DESIGN.md
!schema.sql
!vercel.json
!SESSION.md
!docs
!docs/**
!src
!src/**
!public
!public/**
!scripts
!scripts/**
!specs
!specs/**
# Frozen data snapshot for the live demo (derived from public IDX disclosures,
# regeneratable via `npm run backfill`). No secrets inside.
!data
!data/*.json
!data/derived-v2
!data/derived-v2/*.json
!tests
!tests/**
!playwright.config.ts
!\.github
!\.github/**

test-results
playwright-report
blob-report

.vercel

# local vault helpers — never commit (machine paths + vault internals)
scripts/store-secret.ps1
