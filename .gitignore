# Reverse allowlist: everything ignored unless explicitly unignored.
# Protects secrets and machine files from ever entering the public repo.
*
!.gitignore
!.env.example
!package.json
!package-lock.json
!tsconfig.json
!next-env.d.ts
!next.config.ts
!postcss.config.mjs
!eslint.config.mjs
!README.md
!AGENTS.md
!CLAUDE.md
!schema.sql
!vercel.json
!src
!src/**
!public
!public/**
!scripts
!scripts/**
!specs
!specs/**
